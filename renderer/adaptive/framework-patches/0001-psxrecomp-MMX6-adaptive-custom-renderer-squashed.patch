+def stamp_interleaved(a, b):
+    t = 0.0
+    for pair_a, pair_b in zip(a, b):
+        pair_a["summary"]["route_start_wall"] = t
+        pair_a["summary"]["route_end_wall"] = t + 0.4
+        t += 1.0
+        pair_b["summary"]["route_start_wall"] = t
+        pair_b["summary"]["route_end_wall"] = t + 0.4
+        t += 1.0
