+    half_at(0x80097214u, 5120);
+    half_at(0x80097216u, 0);
+    for (unsigned i = 0; i < 3; i++) {
+        uint32_t b = 0x971f8u + i * 0x54;
+        ((uint8_t *)test_ram)[b] = 1;
+        ((uint8_t *)test_ram)[b + 0x52] = 255;
+        ((uint8_t *)test_ram)[b + 0x4e] = 25;
